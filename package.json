{
  "name": "data-governance-toolkit",
  "version": "1.0.0",
  "description": "Comprehensive Data Governance Toolkit for Government Officials",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "crawler",
    "newsletters"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:*\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:crawler": "cd crawler && npm run dev",
    "dev:newsletter": "cd newsletters && npm run dev",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky install",
    "crawl": "cd crawler && npm run crawl",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "deploy": "npm run deploy --workspaces"
  },
  "keywords": [
    "data-governance",
    "ai",
    "government",
    "content-curation"
  ],
  "author": "SynthoraAI Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^8.0.3",
    "prettier": "^3.1.1",
    "@types/node": "^20.10.6",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hoangsonww/AI-Gov-Content-Curator.git"
  },
  "bugs": {
    "url": "https://github.com/hoangsonww/AI-Gov-Content-Curator/issues"
  },
  "homepage": "https://synthoraai.vercel.app"
}
